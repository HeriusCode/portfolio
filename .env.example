# ==========================================
# DEVELOPER PORTFOLIO ENVIRONMENT CONFIGURATION
# ==========================================

# Port to bind backend Express server
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=production

# Admin Security Password (Used to authenticate and update Top Announcement)
ADMIN_PASSWORD=admin@2026

# HMAC / JWT Secret Key for token signing
JWT_SECRET=super_secret_jwt_key_for_developer_portfolio_2026

# SQLite database path (inside container: /app/backend/data/portfolio.db)
DB_PATH=./backend/data/portfolio.db

# ------------------------------------------
# MOBILE PUSH NOTIFICATION PROVIDERS
# (Configure at least ONE of the services below for phone push alerts)
# ------------------------------------------

# Pushbullet Access Token (Get from https://www.pushbullet.com/#settings/account)
PUSHBULLET_ACCESS_TOKEN=

# Bark Device Key (Get from Bark iOS App https://github.com/Finb/Bark)
BARK_DEVICE_KEY=
BARK_SERVER_URL=https://api.day.app

